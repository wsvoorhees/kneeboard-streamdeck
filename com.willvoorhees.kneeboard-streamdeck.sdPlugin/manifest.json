{
  "Name": "Kneeboard-Streamdeck",
  "Version": "0.5.0.0",
  "Author": "Will Voorhees",
  "Description": "Control OpenKneeboard tabs, profiles, VR placement, visibility, and opacity from Stream Deck.",
  "Category": "Kneeboard-Streamdeck",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "URL": "https://github.com/wsvoorhees/kneeboard-streamdeck",
  "UUID": "com.willvoorhees.kneeboard-streamdeck",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Switch Profile",
      "UUID": "com.willvoorhees.kneeboard-streamdeck.profile-select",
      "Icon": "imgs/actions/overlay-control/icon",
      "Tooltip": "Switch to a named OpenKneeboard profile.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Push": "Switch profile"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/overlay-control/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Show Tab",
      "UUID": "com.willvoorhees.kneeboard-streamdeck.tab-select",
      "Icon": "imgs/actions/view-select/icon",
      "Tooltip": "Show a named OpenKneeboard tab on one view.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Push": "Show tab"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/view-select/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Adjust Placement",
      "UUID": "com.willvoorhees.kneeboard-streamdeck.placement-dial",
      "Icon": "imgs/actions/placement-dial/icon",
      "Tooltip": "Turn a dial or press a key to nudge an axis or resize; set ticks per page.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Rotate": "Nudge axis"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/placement-dial/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Reset Position",
      "UUID": "com.willvoorhees.kneeboard-streamdeck.placement-reset",
      "Icon": "imgs/actions/placement-reset/icon",
      "Tooltip": "Undo every nudge sent since placement was entered.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/placement-reset/key",
          "TitleAlignment": "middle"
        }
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Push": "Reset position"
        }
      }
    },
    {
      "Name": "Recentre VR",
      "UUID": "com.willvoorhees.kneeboard-streamdeck.recentre",
      "Icon": "imgs/actions/recentre/icon",
      "Tooltip": "Recentre the kneeboard on your current view.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/recentre/key",
          "TitleAlignment": "middle"
        }
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Push": "Recentre VR"
        }
      }
    },
    {
      "Name": "Select View",
      "UUID": "com.willvoorhees.kneeboard-streamdeck.view-select",
      "Icon": "imgs/actions/view-select/icon",
      "Tooltip": "Point the placement dials at this view.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/view-select/key",
          "TitleAlignment": "middle"
        }
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Push": "Select view"
        }
      }
    },
    {
      "Name": "Show View",
      "UUID": "com.willvoorhees.kneeboard-streamdeck.view-visibility",
      "Icon": "imgs/actions/view-visibility/icon",
      "Tooltip": "Show or hide a view, putting its tab on it first.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/view-visibility/key",
          "TitleAlignment": "middle"
        }
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Push": "Show or hide view"
        }
      }
    },
    {
      "Name": "Fade View",
      "UUID": "com.willvoorhees.kneeboard-streamdeck.view-opacity",
      "Icon": "imgs/actions/view-opacity/icon",
      "Tooltip": "Fade the selected view up or down.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Rotate": "Adjust opacity",
          "Push": "Fade by configured step"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/view-opacity/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ],
  "PropertyInspectorPath": "ui/configure.html"
}
